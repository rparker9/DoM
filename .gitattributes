# Normalize line endings for text files.
* text=auto

# Code and Unity text assets
*.cs        text diff=csharp
*.asmdef    text
*.md        text
*.json      text
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.anim      text
*.controller text
*.meta      text

# Binary files: never diff or change line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
*.ttf  binary
*.otf  binary
